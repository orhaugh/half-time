{
 "uid": "half-time",
 "title": "half-time",
 "tags": [
  "clink"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "editable": true,
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Resident memory per clink process",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "clink_process_resident_memory_bytes",
     "legendFormat": "{{role}} {{instance}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "CPU per clink process",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "clink_process_cpu_percent",
     "legendFormat": "{{role}} {{instance}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Checkpoint duration",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "clink_ckpt_duration_ms",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Checkpoints completed and failed per minute",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(clink_ckpt_completed_total[1m])) * 60",
     "legendFormat": "completed"
    },
    {
     "refId": "B",
     "expr": "sum(rate(clink_ckpt_failed_total[1m])) * 60",
     "legendFormat": "failed"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Subtasks running per Worker",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "clink_worker_subtasks_running",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Surge multiplier by zone, percent (from the Pushgateway)",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "halftime_zone_multiplier_pct",
     "legendFormat": "{{zone}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Jobs running and Workers registered",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "clink_coordinator_jobs_running",
     "legendFormat": "jobs"
    },
    {
     "refId": "B",
     "expr": "clink_coordinator_workers_registered",
     "legendFormat": "workers"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Worker control reconnects",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(clink_worker_control_reconnects_total[5m])",
     "legendFormat": "{{instance}}"
    }
   ]
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}
